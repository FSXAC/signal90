{
  "$description": "SIGNAL/90 design tokens (W3C Design Tokens / DTCG draft format). CSS custom-property names are given in $extensions.css. Source of truth for values; signal90.css mirrors them.",
  "color": {
    "$type": "color",
    "void": {
      "$value": "#050404",
      "$description": "Base field. Never pure #000.",
      "$extensions": {
        "css": "--void"
      }
    },
    "void-2": {
      "$value": "#0d0a09",
      "$description": "Raised panel field.",
      "$extensions": {
        "css": "--void-2"
      }
    },
    "paper": {
      "$value": "#e8ebe2",
      "$description": "Inverse LCD screens only (clocks, data sheets).",
      "$extensions": {
        "css": "--paper"
      }
    },
    "red": {
      "$value": "#ff1a2e",
      "$description": "FAULT / DENY / DANGER. The only colour allowed to strobe.",
      "$extensions": {
        "css": "--red",
        "semantic": "fault"
      }
    },
    "red-deep": {
      "$value": "#7a0612",
      "$description": "Field behind kanji bands and alarm gradients.",
      "$extensions": {
        "css": "--red-deep"
      }
    },
    "amber": {
      "$value": "#ff8a1c",
      "$description": "NEUTRAL DATA: labels, rules, readouts, ornament. Default ink.",
      "$extensions": {
        "css": "--amber",
        "semantic": "data"
      }
    },
    "phosphor": {
      "$value": "#39ff6a",
      "$description": "Wireframe, topo lines, terminal text, LED meters.",
      "$extensions": {
        "css": "--phosphor",
        "semantic": "trace"
      }
    },
    "mint": {
      "$value": "#7df5b4",
      "$description": "NOMINAL / APPROVE / PASS / filled cell.",
      "$extensions": {
        "css": "--mint",
        "semantic": "ok"
      }
    },
    "sky": {
      "$value": "#a8c8f2",
      "$description": "Inert panels, secondary series, cold data.",
      "$extensions": {
        "css": "--sky",
        "semantic": "secondary"
      }
    },
    "violet": {
      "$value": "#6e3cff",
      "$description": "Spectrum floor, deep scans.",
      "$extensions": {
        "css": "--violet"
      }
    },
    "magenta": {
      "$value": "#ff2f8e",
      "$description": "Interference patterns, wave overlays.",
      "$extensions": {
        "css": "--magenta"
      }
    },
    "hazard": {
      "$value": "#ffd21a",
      "$description": "Hazard stripe pairs only. Never text.",
      "$extensions": {
        "css": "--hazard"
      }
    },
    "doc-blue": {
      "$value": "#2a2ed6",
      "$description": "Clearance cards, paper documents.",
      "$extensions": {
        "css": "--doc-blue"
      }
    },
    "dim-amber": {
      "$value": "#4a2208",
      "$description": "Unlit LED cell / empty slot on amber meters.",
      "$extensions": {
        "js": "DIMA"
      }
    },
    "dim-green": {
      "$value": "#0f2a18",
      "$description": "Unlit LED cell on green meters.",
      "$extensions": {
        "js": "DIMG"
      }
    },
    "dim-red": {
      "$value": "#3a0610",
      "$description": "Unlit LED cell on red meters.",
      "$extensions": {
        "js": "DIMR"
      }
    }
  },
  "gradient": {
    "spectrum": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#ff1a2e",
          "position": 0
        },
        {
          "color": "#ff8a1c",
          "position": 0.22
        },
        {
          "color": "#ffd21a",
          "position": 0.4
        },
        {
          "color": "#39ff6a",
          "position": 0.62
        },
        {
          "color": "#2a7bff",
          "position": 0.82
        },
        {
          "color": "#6e3cff",
          "position": 1
        }
      ],
      "$description": "Instrument ramp. Channel gauges and header wedges only.",
      "$extensions": {
        "css": "--spectrum"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "helv": {
      "$value": [
        "Helvetica Neue",
        "Helvetica",
        "Arimo",
        "Arial",
        "sans-serif"
      ],
      "$description": "The ONE display/UI family. Weight 700, UPPERCASE, stretched with scaleX.",
      "$extensions": {
        "css": "--f-helv"
      }
    },
    "mono": {
      "$value": [
        "Share Tech Mono",
        "ui-monospace",
        "monospace"
      ],
      "$description": "Terminal dumps, logs, tables, small data.",
      "$extensions": {
        "css": "--f-mono"
      }
    },
    "mincho": {
      "$value": [
        "Shippori Mincho B1",
        "Hiragino Mincho ProN",
        "serif"
      ],
      "$description": "Kanji stamps only, weight 800.",
      "$extensions": {
        "css": "--f-mincho"
      }
    }
  },
  "stretch": {
    "$type": "number",
    "$description": "Horizontal glyph scale (transform: scaleX). Helvetica is distorted, never swapped for condensed/extended cuts.",
    "tall": {
      "$value": 0.56,
      "$description": "Shout: one word, full bleed, heroes.",
      "$extensions": {
        "css": "--sx-tall",
        "class": ".tall"
      }
    },
    "cond": {
      "$value": 0.74,
      "$description": "Headings, panel names, chain values.",
      "$extensions": {
        "css": "--sx-cond",
        "class": ".cond"
      }
    },
    "label": {
      "$value": 0.84,
      "$description": "Inside every .tag.",
      "$extensions": {
        "css": "--sx-label",
        "class": ".hx"
      }
    },
    "wide": {
      "$value": 1.18,
      "$description": "Blunt warnings (DANGER, REFUSED, KEEP OUT).",
      "$extensions": {
        "css": "--sx-wide",
        "class": ".wide"
      }
    }
  },
  "motion": {
    "$type": "duration",
    "frame": {
      "$value": "41.667ms",
      "$description": "1 film frame @ 24 fps.",
      "$extensions": {
        "css": "--frame",
        "js": "FR"
      }
    },
    "anime-frame": {
      "$value": "83.333ms",
      "$description": "1 anime frame (drawn on twos, 12/s). The update grid for ALL UI state changes.",
      "$extensions": {
        "css": "--af",
        "js": "AF"
      }
    },
    "strobe-state": {
      "$value": "41.667ms",
      "$description": "Each strobe state holds 1 film frame → 12 Hz. Owner-tuned.",
      "$extensions": {
        "css": "--strobe-frames: 1"
      }
    },
    "blink-cycle": {
      "$value": "666.667ms",
      "$description": "Non-critical blink: 4 anime frames on / 4 off.",
      "$extensions": {
        "css": "--blink"
      }
    },
    "power-on": {
      "$value": "333.333ms",
      "$description": "flick-on: 4 anime frames.",
      "$extensions": {
        "class": ".flick-on"
      }
    },
    "wire-draw": {
      "$value": "500ms",
      "$description": "Connectors draw in over 6 anime frames, linear steps.",
      "$extensions": {
        "js": "drawWires(root, every, 6)"
      }
    },
    "shot-min": {
      "$value": "667ms",
      "$description": "Reel/screen cut: 6–13 anime frames per shot.",
      "$extensions": {}
    },
    "shot-max": {
      "$value": "2667ms",
      "$description": "Broadcast default hold.",
      "$extensions": {}
    },
    "cut-grid": {
      "$value": "333.333ms",
      "$description": "Cuts land on a 4-anime-frame grid. Broadcast (default) holds 8 units; breakcore 2/3/4/6.",
      "$extensions": {
        "js": "CUT"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "strobe-off": {
      "$value": 0.42,
      "$description": "Opacity of a strobed element's OFF state (dim afterimage, not hard off). Owner-tuned.",
      "$extensions": {
        "css": "--strobe-off"
      }
    },
    "ghost-segment": {
      "$value": 0.08,
      "$description": "Unlit 7-segment segments.",
      "$extensions": {}
    }
  },
  "effect": {
    "glow": {
      "$type": "shadow",
      "$value": "0 0 .06em currentColor, 0 0 .35em color-mix(in srgb, currentColor 55%, transparent)",
      "$description": "Phosphor text glow. SVG uses filter url(#sglow).",
      "$extensions": {
        "css": "--glow",
        "class": ".glow"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "safe-margin": {
      "$value": "2.5cqw",
      "$description": "Corner-tag inset from the screen edge. All screen sizes are in cqw of a 16:9 container.",
      "$extensions": {}
    },
    "rule": {
      "$value": "0.12em",
      "$description": "Tag / cell border thickness relative to its font size.",
      "$extensions": {}
    }
  },
  "skew": {
    "$type": "number",
    "oblique": {
      "$value": -12,
      "$description": "Oblique accent angle in degrees (skewX). 7-segment readouts use -8.",
      "$extensions": {
        "css": "--skew",
        "class": ".obl / .obl-seg"
      }
    }
  }
}